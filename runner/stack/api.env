# Overrides for api and jobs, loaded after api/.env and api/tmp/.env.branch. Mirrors the
# `environment:` block of hop's compose template, with service hostnames swapped for
# 127.0.0.1. Same format as a compose env_file: KEY=VALUE, no shell expansion.
RAILS_ENV=development
API_DOMAIN=bunny.internal
DB_HOST=127.0.0.1
DB_USERNAME=postgres
DB_PASS=postgres
DB_USER=postgres
DB_PASSWORD=postgres
SMTP_SERVER=127.0.0.1
SIDEKIQ_REDIS_URL=redis://127.0.0.1:6379/0
API_CACHE_REDIS_URL=redis://127.0.0.1:6379/1
API_REDIS_URL=redis://127.0.0.1:6379/1
AUTH_BYPASS_ENABLED=true
SQL_LOGGING=true

# Lightweight-only: Puma in single mode (no forked workers), with fewer glibc malloc arenas.
# For more request concurrency, put WEB_CONCURRENCY=2 in $BUNNY_ROOT/stack.env.
WEB_CONCURRENCY=0
MALLOC_ARENA_MAX=2
