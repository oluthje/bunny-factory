# Copy to .env at the repo root (gitignored, and outside the runner/ build context). Names only; never commit values.
DAYTONA_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
GH_TOKEN=
LINEAR_API_KEY=
SNAPSHOT_NAME=bunny-agent
SANDBOX_CPU=4
SANDBOX_MEMORY=8
SANDBOX_DISK=10
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# The warm snapshot runs start from (runner/out/latest-snapshot after a build).
FACTORY_SNAPSHOT=
# The most runs in flight at once (default 3). Daytona tier 2 fits about 25 runners; the Claude subscription binds first.
FACTORY_MAX_RUNS=3
